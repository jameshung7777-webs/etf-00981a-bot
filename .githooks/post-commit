#!/bin/sh
# 優先交給 PowerShell（改善 Windows、中文路徑、部分 GUI 的 commit 行為）。
HERE=$(CDPATH= cd -- "$(dirname "$0")" && pwd) || exit 0
if command -v powershell.exe >/dev/null 2>&1; then
  exec powershell.exe -NoProfile -ExecutionPolicy Bypass -File "$HERE/post-commit.ps1"
fi
if command -v pwsh >/dev/null 2>&1; then
  exec pwsh -NoProfile -ExecutionPolicy Bypass -File "$HERE/post-commit.ps1"
fi
branch=$(git symbolic-ref -q --short HEAD) || exit 0
[ -n "$branch" ] || exit 0
git remote get-url origin >/dev/null 2>&1 || exit 0
exec git push -u origin "$branch"
